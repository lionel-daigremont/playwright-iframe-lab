{
  "name": "pw-demowebshop",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript sandbox on the Tricentis Demo Web Shop",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "td": "playwright test -c playwright.td.config.ts",
    "td:server": "node --env-file=.env td/server.js",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^2.12.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.73.0"
  }
}
